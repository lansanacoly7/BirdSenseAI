# Base de données Supabase (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres.VOTRE_PROJECT_REF:VOTRE_PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# JWT Configuration
SECRET_KEY=votre_cle_secrete_tres_longue_et_aleatoire_ici_changez_la
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_NAME=BirdSense AI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://birdsense.app

# Seuil de floutage GPS (mètres) — 5 km pour les espèces IUCN EN/CR
GPS_BLUR_RADIUS_METERS=5000
